# Copy to .env.local for the local Cognitrace stack.
# Change VITE_API_BASE_URL when your backend host changes.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_USE_MOCK_API=false

# Local Supabase Auth. Replace the publishable key with your local Supabase key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_local_supabase_publishable_key
